{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": { "maxDuration": 60, "excludeFiles": "{tests,samples,examples,migrations}/**" }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }],
  "crons": [{ "path": "/v1/billing/sync", "schedule": "17 4 * * *" }]
}
