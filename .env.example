# Copy to .env and fill in. Leave STRIPE_SECRET_KEY empty to run without billing (dev mode).
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Printed by `python scripts/setup_stripe.py`
STRIPE_PRICE_ID=price_...
STRIPE_METER_EVENT_NAME=normalize_call
# Display-only; the real price lives on the Stripe Price
PRICE_PER_CALL_USD=0.005
PUBLIC_BASE_URL=http://localhost:8000
DB_PATH=normalizer.db

# Used by the MCP server
NORMALIZER_API_URL=http://localhost:8000
NORMALIZER_API_KEY=cn_...
