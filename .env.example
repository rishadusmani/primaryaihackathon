# Optional settings. Canon runs with none of them.

# Require `Authorization: Bearer <key>` on the API and MCP endpoints.
# CANON_API_KEYS=change-me

# SQLite file for `python -m canon serve` and `python -m canon mcp`.
# CANON_DB=canon.db

# Claude extraction for scanned faxes (pip install anthropic).
# ANTHROPIC_API_KEY=sk-ant-...

# Second opinion on conditions the rules were unsure about (negated, family, hedged).
# OPENAI_API_KEY=sk-...
# CANON_ASSERTION=0   # turn it off
