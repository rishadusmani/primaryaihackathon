# Copy to your Vercel project's Environment Variables (never commit real values).

# Supabase Postgres via the transaction pooler (port 6543), as the least-privilege
# canon_app role from migrations/002_app_role.sql.
DATABASE_URL=postgresql://canon_app.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require

# Stripe (use sk_test_ keys until you go live)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...          # from: python -m canon.billing setup --price-cents 5

CANON_PUBLIC_URL=https://<your-app>.vercel.app
CANON_FREE_PAGES=0                 # free pages per account before a subscription is required
CANON_LLM_PAGE_UNITS=1             # billing units per page read by Claude (scanned faxes)
CRON_SECRET=<random string>        # Vercel sends it to the /v1/billing/sync cron

# Optional: Claude extraction for scanned faxes
# ANTHROPIC_API_KEY=sk-ant-...
